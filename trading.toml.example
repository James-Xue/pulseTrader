# trading.toml.example — pulseTrader 交易配置模板
#
# 复制本文件为 trading.toml 并按需修改。
# "from_env:VAR_NAME" 语法从环境变量读取敏感值（推荐用于 API Key 等）。
# 所有字段均可选 — 省略时使用合理默认值。
#
# 用法：
#   ./run.sh trade --config trading.toml
#   pulsetrader --config trading.toml

# ── 交易币种（顶级键，必须在所有 [section] 之前）─────────────────────
# WebSocket 订阅的币种列表，策略只能使用此列表中的币种。
symbols = ["BTC_USDT", "ETH_USDT"]

# ── 默认市场类型（可选，默认 spot）──────────────────────────────────
# 策略未指定 market_type 时使用此值。可选: "spot" | "futures" | "cfd"
# default_market_type = "spot"

# ── 活跃交易方向（可选，默认 futures）────────────────────────────────
# 单活跃方向模型：任一时刻只有一个方向（futures / cfd）真实交易。
# 另一方向的策略启动即暂停、切换时撤单；重启后回到此配置值。
# 运行时切换: REPL `switch <futures|cfd>` 或 MCP switch_direction。
# 2026-08-17 起本工程主力为黄金 CFD: 取消下行注释即为持久默认。
active_market = "cfd"

# ── 交易所 ────────────────────────────────────────────────────────────
[exchange]
# testnet = true 使用 Gate.io 合约测试网（虚拟资金），默认 false = 主网（真金白银）
# 测试网仅支持合约，不支持现货。API Key 需要在 https://fx-testnet.gateio.ws 单独创建。
# 开启 testnet 后，REST/WS URL 自动切换为测试网地址，通常不需要手动设置。
testnet             = false
# 以下 URL 通常不需要手动设置 — testnet=true 时自动切换。
# 如需显式配置或覆盖（例如中国用户回退主网行情 WS），取消注释并修改：
# restBaseUrl       = "https://api.gateio.ws"
# wsUrl             = "wss://api.gateio.ws/ws/v4/"
# futuresWsUrl      = "wss://fx-ws.gateio.ws/v4/ws/usdt"
apiKey              = "from_env:GATE_MAINNET_API_KEY"
apiSecret           = "from_env:GATE_MAINNET_API_SECRET"
proxyUrl            = "from_env:HTTPS_PROXY"
restTimeoutMs       = 10000        # HTTP 超时（毫秒）
maxRetries          = 3            # 网络失败重试次数
wsReconnectBaseMs   = 1000         # WS 重连基础退避（毫秒）
wsReconnectMaxMs    = 30000        # WS 重连最大退避（毫秒）

# ── 日志 ─────────────────────────────────────────────────────────────
[log]
level     = "info"                 # trace | debug | info | warn | error | critical | off
logDir    = "logs"
toConsole = true                   # 同时输出到终端
toFile    = true                   # 写入 logs/ 目录

# ── 策略引擎 ─────────────────────────────────────────────────────────
[strategy]
signal_aggregator_threshold = 0.7  # 聚合信号置信度 ≥ 0.7 才执行
signal_cooldown_sec         = 30   # 同币种信号冷却（秒）
# signal_only = false              # true = 启动时把所有策略的 auto_trade 开关
                                   #       置为 OFF: 只发信号(get_signals)永不下单;
                                   #       运行时可用 set_strategy_trading /
                                   #       `autotrade <id> on|off` 逐个一键开启
                                   #       (重启回到此默认)。手动 open_order/
                                   #       close_position 不受影响(子代理路径)

# 每个 [[strategy.instances]] 定义一个策略实例。
# name 必须是: momentum_scalper | orderbook_scalper | mean_reversion_scalper
#
# order_type（可选，默认 "market"）:
#   "market"      — 市价单（吃单，taker 费率，如合约 0.05%/边）
#   "post_only"   — 最优买卖价挂单（做市，maker 费率如 0.02%/边）；无行情簿
#                   数据时丢弃信号，绝不吃单
#   "maker_first" — 挂单优先 + 超时后撤单转市价兜底（见 maker_timeout_ms）
# maker_timeout_ms（仅 maker_first 生效）: 挂单未成交等待毫秒数，超时撤单
#   改市价单。示例: 0.01 手 XAUUSD 一轮 maker 可省约 0.06% 手续费
#   注意: CFD 市场不支持 post_only（TradFi API 仅 market|trigger），
#   验证器会拒绝 cfd + 非 market 的组合

[[strategy.instances]]
name            = "momentum_scalper"
symbol          = "BTC_USDT"
order_quantity  = 0.001            # 每笔 0.001 BTC（约 $65）
min_confidence  = 0.6              # 信号置信度门槛（0.0–1.0）；注意各策略置信度
                                    # 尺度不同——momentum 的 EMA 间距归一化约 1e-4、
                                    # mean_reversion 的带宽穿透比约 0.01-0.1，高门槛
                                    # 会把它们永久静默（只留 distance/ATR 尺度的
                                    # supertrend），低尺度策略请设 0.0
enabled         = true
poll_interval_ms = 200             # 行情轮询间隔（毫秒）

[[strategy.instances]]
name            = "orderbook_scalper"
symbol          = "BTC_USDT"
order_quantity  = 0.001
min_confidence  = 0.65
enabled         = true
poll_interval_ms = 100             # 订单簿策略需要更快轮询

[[strategy.instances]]
name            = "mean_reversion_scalper"
symbol          = "ETH_USDT"
order_quantity  = 0.01             # 每笔 0.01 ETH（约 $35）
min_confidence  = 0.6
enabled         = true
poll_interval_ms = 500

# ── 合约策略示例（取消注释启用）──────────────────────────────────────
# 合约交易需要 Gate.io 合约账户和合约 API 权限。
# ⚠️ 合约交易有爆仓风险，杠杆放大盈亏，请谨慎使用。
#
# [[strategy.instances]]
# name            = "momentum_scalper"
# symbol          = "BTC_USDT"
# market_type     = "futures"       # 合约市场（默认 "spot"）
# leverage        = 5               # 杠杆倍数（1.0 = 无杠杆，最大 125.0）
# margin_mode     = "cross"         # 保证金模式: "cross"（全仓）| "isolated"（逐仓）
# order_quantity  = 1               # 合约张数（整数，非 base 币量）
# min_confidence  = 0.65
# enabled         = true
# poll_interval_ms = 200

# ── 币种定制策略示例: eth_scalper（M26, 追空 + 自定义参数）────────────
# 未注册的 name 会兜底为被动 UnifiedScalper(不发信号)并在启动日志 WARN;
# 新增币种策略 = 继承 UnifiedScalper + 在 StrategyRegistry 注册 name。
# custom_params 为币种专属参数表(静态, 无热更新), 缺省走策略默认值:
#   eth_atr_step             (默认 0.05) — ATR 自适应止盈距离 suggested_tp = close - step×atr
#   eth_spike_filter_usd     (默认 120.0) — 单根 kline 振幅超过此值视为暴拉/插针, 不追空
#   eth_min_confidence_scale (默认 1.0)   — 置信度缩放系数。实测 |EMA9-EMA21|/ATR
#                                           仅 ~0.03,乘 1.0 永远过不了 min_confidence=0.6
#                                           闸,真信号被 emitSignal 静默丢弃;主网已用 20.0
#                                           (典型交叉 ~0.65 过闸,仍守 0.6 语义)
#
# [[strategy.instances]]
# name            = "eth_scalper"
# symbol          = "ETH_USDT"
# market_type     = "futures"
# leverage        = 10
# margin_mode     = "cross"
# order_quantity  = 20               # 1 合约 = 0.01 ETH (~20 USD @2011)
# min_confidence  = 0.6
# enabled         = true
# poll_interval_ms = 500
# custom_params  = { eth_atr_step = 0.05, eth_spike_filter_usd = 120.0, eth_min_confidence_scale = 1.0 }
# order_type      = "maker_first"   # "market"（默认）| "post_only" | "maker_first"
# maker_timeout_ms = 500            # 挂单超时毫秒，超时撤单改市价（仅 maker_first）

# ── 五周期 EMA 共振策略示例: ema_resonance_scalper（2026-08-23）────────
# EMA 7/14/30/60/200 全排列对齐才出信号: 严格递增 = 多头共振 Buy,
# 严格递减 = 空头共振 Sell, 其余 mixed 无信号。入场为共振状态迁移触发
# (非每根 K 线重发); 置信度 = clamp(|ema7-ema200|/ATR,0,1)×res_conf_scale。
# custom_params 语义 (静态, 无热更新, 缺省走默认值):
#   res_ema_p1      (默认 7)    — 最快 EMA 周期
#   res_ema_p2      (默认 14)
#   res_ema_p3      (默认 30)
#   res_ema_p4      (默认 60)
#   res_ema_p5      (默认 200)  — 最慢 EMA 周期
#   res_conf_scale  (默认 1.0)  — 置信度缩放系数。实测 |ema7-ema200|/ATR ≈ 0.55
#                                 不过 min_confidence=0.6 闸被静默丢弃;主网已用
#                                 2.0 (典型对齐 ~1.0 过闸, 仍守 0.6 语义)
# 规则文档: docs/strategies/ema-resonance-scalper.md
#
# [[strategy.instances]]
# name            = "ema_resonance_scalper"
# symbol          = "ETH_USDT"
# market_type     = "futures"
# leverage        = 10
# margin_mode     = "cross"
# order_quantity  = 20
# min_confidence  = 0.6
# enabled         = true
# poll_interval_ms = 500
# custom_params  = { res_ema_p1 = 7, res_ema_p2 = 14, res_ema_p3 = 30, res_ema_p4 = 60, res_ema_p5 = 200, res_conf_scale = 2.0 }

# ── 风控 ─────────────────────────────────────────────────────────────
[risk]
maxPositionNotional = 500          # 最大总持仓（USDT）
maxOpenPositions    = 3            # 最多同时持仓数
maxDailyDrawdown    = 0.02         # 日亏 ≥ 2% 停止开仓
maxDrawdown         = 0.05         # 总回撤 ≥ 5% 全部停止
maxOrdersPerSec     = 5            # 每秒最大下单数
maxSymbolNotional   = 300          # 单币种最大持仓（USDT）
max_leverage        = 10.0         # 最大杠杆倍数（1.0–500.0；CFD 杠杆阶梯 20/50/100/200/500）
max_margin_used     = 0.5          # 保证金占总资产最大比例（0.0–1.0）
# minAvailableAfterStopUsd = 6.0   # M22: CFD 带 SL 开仓后,可用资金-保证金-止损金额
                                   # 必须 ≥ 此值;防止薄账户一笔止损即耗尽交易能力(默认关)

[risk.stop_loss]
mode            = "Trailing"       # Fixed | Trailing | TimeBased
trailing_pct    = 0.005            # 追踪止损偏移 0.5%
fixed_pct       = 0.01             # 固定止损 1%（mode=Fixed 时使用）
max_hold_seconds = 300             # 最大持仓时间 5 分钟（mode=TimeBased 时使用）

[risk.take_profit]
enabled     = true
targets_pct = [0.005, 0.01, 0.02]  # 止盈目标：+0.5%, +1%, +2%
fractions   = [0.33, 0.33, 0.34]   # 每档平仓比例（总和 ≤ 1.0）

# ── AI 分析 ──────────────────────────────────────────────────────────
# heartbeatIntervalSec = 0 关闭 AI 调参（推荐初期关闭）
[ai]
# AI 定期调参闭环:LLM 每 heartbeatIntervalSec 秒评估市场 + 每策略近期表现,
# 经安全边界微调全部策略参数(变更可在 get_param_history 审计)。
backend              = "claude"              # "claude" 或 "openai";可配 baseUrl 指向兼容网关
model                = "claude-sonnet-4-6"
apiKey               = "from_env:AI_API_KEY" # 无 key → AI 离线(安全禁用),key 一填即通电
heartbeatIntervalSec = 300                   # AI 调参节奏(秒),0 = 关闭
stats_lookback_hours = 24                    # AI prompt 中每策略表现统计窗口(小时)
requestTimeoutMs     = 30000
maxRetries           = 2

# ── Twitter/X 社交信号 ───────────────────────────────────────────────
[twitter]
enabled         = false
bearerToken     = "from_env:TWITTER_BEARER_TOKEN"
keywords        = ["bitcoin", "crypto", "BTC"]
maxTweets       = 20               # 滚动窗口大小
pollIntervalSec = 300              # 轮询间隔（秒）

# ── 新闻信号 ─────────────────────────────────────────────────────────
[news]
enabled         = false
apiKey          = "from_env:NEWS_API_KEY"
provider        = "newsapi"        # "newsapi" 或 "cryptopanic"
keywords        = ["bitcoin", "crypto regulation"]
maxArticles     = 20
pollIntervalSec = 300

# ── WebUI 仪表盘 ─────────────────────────────────────────────────────
# 需要编译时启用 -DPULSE_ENABLE_WEBUI=ON
[webui]
enabled     = true
bindAddress = "127.0.0.1"          # 仅本机访问，不要暴露到网络
port        = 8080
authToken   = "from_env:PULSE_WEBUI_TOKEN"
maxClients  = 4                    # 最大 WebSocket 连接数

# ── SQLite 交易记录 ──────────────────────────────────────────────────
# 需要编译时启用 -DPULSE_ENABLE_SQLITE=ON
[sqlite]
enabled = true
dbPath  = "data/trades.db"         # SQLite 数据库文件路径
record_market = false             # M18: 行情(ticker/kline)落库,同文件第二连接
# skip_kline_markets = ["futures"]  # M30: 不写这些市场的 kline_bars(如合约,改由 REST 实时拉);ticker_ticks 不受影响
# daily_kline_sync = true           # M31: 每日拉近 10000 根 1m k线合并入库(REST 深度上限)
# daily_sync_hour = 8               # 北京时刻;UTC 00:00 == 北京 08:00

# ── 引擎内网格服务 (M27) ─────────────────────────────────────────────
# ETH 网格 v2 规则(commit_my_life gate交易/以太坊 策略文档 v2)的引擎原生实现。
# 默认全部走 GridConfig 缺省值(enabled=false),此处为全字段示例。
# 启用:enabled = true → 引擎重启时自动加载 data/grid_state.json;
#   若状态为 Running(schema 2)→ 自动恢复运行(崩溃存活卖点);
#   要手动接管:先 grid_pause 再停机(pause 会落盘)。
[grid]
enabled = false                    # true 时引擎启动即加载网格状态
symbol = "ETH_USDT"                # 期货合约
market_type = "futures"            # 仅支持 futures
levels = 12                        # 网格格数
qty_per_level = 0.02               # 每格张数(2 × 0.01 ETH)
step_mode = "atr"                  # "atr"(clamp(0.5×ATR15m)) | "fixed"
step_fixed = 5.0                   # fixed 模式的固定步进
step_atr_mult = 0.5                # ATR 自适应步进系数
step_min = 3.0                     # ATR 步进下限
step_max = 8.0                     # ATR 步进上限
atr_period = 40                    # ATR15m:1m TR 均值所用根数
tp_distance_steps = 2.0            # 分格止盈 = 成交价 - n×step(reduce-only 限价买)
anchor_offset_steps = 1.0          # 锚 = round(mid + n×step, step)
lower_reanchor_steps = 3.0         # mid < 锚 - n×step → 下移重锚
# (无 upper_reanchor_steps:涨穿网格不自动重锚 — v2 §3.1b 转保护线 A)
protect_line_a_steps = 2.0         # 1m 收盘 > 顶 + n×step → 平网格份额+按 §3.1 重挂
protect_line_b_usd = -30.0         # 网格浮亏 ≤ 此值 → 同保护线 A
daily_loss_limit_usd = -10.0       # 日已实现亏损 ≤ 此值 → 冻结新格/重锚(存量 TP 照常)
daily_reset_hour = 8               # 日界(北京 08:00 == UTC 00:00)
reanchor_cooldown_min = 30         # 重锚冷却
spike_freeze_min = 30              # 暴拉冻结期
spike_pct = 0.01                   # 1m 涨幅 > 1%
spike_atr_mult = 3.0               # 或 > 3×ATR15m,任一触发即冻结
state_file = "data/grid_state.json" # 状态文件(tmp+rename 原子写)
force = false                      # 有非网格持仓时仍允许 grid_start
